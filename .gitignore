# TypeScript 증분 빌드 산출물 — 매번 바뀌므로 추적하면 안 됨
*.tsbuildinfo

# Next.js가 자동 생성. `next dev`를 마지막으로 돌렸는지 `next build`을
# 돌렸는지에 따라 import 경로가 .next/types ↔ .next/dev/types로 뒤집혀서,
# 추적하면 커밋마다 의미 없는 변경이 붙는다. 어느 쪽이든 dev/build를
# 실행하면 다시 만들어진다.
next-env.d.ts

# API 키가 들어있는 파일 — 절대 커밋하지 않음
# (.env.local을 쓴다. .env도 습관상 만들 수 있으니 함께 무시)
.env
.env.local
.env.*.local
