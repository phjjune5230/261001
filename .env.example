# ─────────────────────────────────────────────
# 접근 잠금 (필수 — 없으면 잠금 화면이 열리지 않습니다)
# ─────────────────────────────────────────────
# ⚠️ 절대 NEXT_PUBLIC_ 접두사를 붙이지 마세요.
#    붙이면 이 값들이 클라이언트 JS 번들에 평문으로 실립니다.
#    접두사가 없을 때만 서버에서만 읽힙니다.
#
# APP_TOKEN 예시:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_PIN=123456
APP_TOKEN=여기에-아무-긴-랜덤-문자열

# ─────────────────────────────────────────────
# LLM 프로바이더 API 키
# 키가 없는 provider는 화면에 나타나도 호출이 실패합니다.
# ─────────────────────────────────────────────

# OpenRouter API 키
OPENROUTER_API_KEY=sk-or-...

# Groq API 키
GROQ_API_KEY=gsk_...

# Google Gemini API 키
GEMINI_API_KEY=AIza...

# ─────────────────────────────────────────────
# 대화 저장 — Supabase (선택)
# ─────────────────────────────────────────────
# 없어도 앱은 동작합니다. 이때는 대화가 화면에만 남고 새로고침하면 사라집니다.
# 채팅·영어 기능 자체는 그대로 쓸 수 있습니다 (D-018, D-022).
#
# ⚠️ SUPABASE_SERVICE_ROLE_KEY에 절대 NEXT_PUBLIC_ 접두사를 붙이지 마세요.
#    이 키는 RLS를 완전히 우회합니다. 접두사가 붙는 순간 JS 번들에 평문으로
#    실려 URL을 아는 누구나가 대화를 전부 내려받을 수 있습니다.
#    anon 키는 이제 클라이언트에서 읽지 않으므로 NEXT_PUBLIC_로 둘 이유가
#    없어졌습니다. 번들만 가벼워집니다.
#
# 둘 다 Supabase 대시보드 → Project Settings → API 에서 찾습니다.
# service_role 키는 anon 키보다 크고, 대시보드 하단 API Keys 목록에
# service_role 항목이 있습니다. 처음 보는 키입니다.
#
# 스키마는 supabase/schema.sql 다음 supabase/single-user.sql 순서로 실행하세요.

# Supabase 프로젝트 URL
SUPABASE_URL=https://여러분의프로젝트.supabase.co

# service_role 키 — 서버 전용. 클라이언트로 나가지 않습니다.
SUPABASE_SERVICE_ROLE_KEY=여기에-service_role-키