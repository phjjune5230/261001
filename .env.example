# ─────────────────────────────────────────────
# 접근 잠금 (필수 — 없으면 잠금 화면이 열리지 않습니다)
# ─────────────────────────────────────────────
# ⚠️ 절대 NEXT_PUBLIC_ 접두사를 붙이지 마세요.
#    붙이면 이 값들이 클라이언트 JS 번들에 평문으로 실립니다.
#    접두사가 없을 때만 서버에서만 읽힙니다.
#
# APP_TOKEN 예시:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_PIN=123456
APP_TOKEN=여기에-아무-긴-랜덤-문자열

# ─────────────────────────────────────────────
# LLM 프로바이더 API 키
# 키가 없는 provider는 화면에 나타나도 호출이 실패합니다.
# ─────────────────────────────────────────────

# OpenRouter API 키
OPENROUTER_API_KEY=sk-or-...

# Groq API 키
GROQ_API_KEY=gsk_...

# Google Gemini API 키
GEMINI_API_KEY=AIza...